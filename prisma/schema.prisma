generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id                     String    @id @default(uuid())
  creator_id             String
  title                  String    @db.VarChar(150)
  description            String    @db.Text
  category               String    @db.VarChar(50)
  reward_coins           Int
  quota                  Int
  total_reward_coins     BigInt
  steps                  Json
  proof_requirements     Json
  execution_time_minutes Int       @default(60)
  auto_approval_days     Int       @default(3)
  status                 String    @default("DRAFT") @db.VarChar(20)
  version                Int       @default(1)
  closed_at              DateTime?
  grace_period_ends_at   DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  audit_logs             TaskAuditLog[]
  claims                 TaskClaim[]

  @@index([creator_id])
  @@index([status])
  @@map("tasks")
}

model TaskAuditLog {
  id         String   @id @default(uuid())
  task_id    String
  admin_id   String
  action     String   @db.VarChar(100)
  old_value  Json?
  new_value  Json?
  created_at DateTime @default(now())

  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([admin_id])
  @@map("task_audit_logs")
}

model TaskClaim {
  id           String    @id @default(uuid())
  task_id      String
  worker_id    String
  status       String    @default("IN_PROGRESS") @db.VarChar(20)
  claimed_at   DateTime  @default(now())
  expires_at   DateTime
  submitted_at     DateTime?
  submitted_proofs Json?
  completed_at     DateTime?
  reviewer_id      String?   @db.VarChar(100)
  reviewed_at      DateTime?
  rejection_reason String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  task         Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id, status])
  @@index([worker_id, task_id])
  @@index([expires_at])
  @@index([status, submitted_at])
  @@map("task_claims")
}

model WorkerWallet {
  id         String   @id @default(uuid())
  worker_id  String   @unique @db.VarChar(100)
  balance    Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("worker_wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  wallet_id     String
  worker_id     String   @db.VarChar(100)
  type          String   @db.VarChar(30)
  amount        Int
  balance_after Int
  reference_id  String?  @db.VarChar(100)
  description   String   @db.VarChar(255)
  created_at    DateTime @default(now())

  wallet        WorkerWallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([worker_id])
  @@index([wallet_id])
  @@index([reference_id])
  @@map("wallet_transactions")
}

